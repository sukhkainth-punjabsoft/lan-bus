# Truxo dev bus — copy to ~/.config/truxo-bus/config.env

BUS_URL=https://dev.truxo.app/api/v1/bus
BUS_ORIGIN=https://dev.truxo.app

# Your name on the bus. This is how the server knows not to wake you with your
# own messages, so it MUST be unique across the team — if two people pick the
# same name they become one identity and permanently stop seeing each other.
# Normalised to lowercase; punctuation becomes "-".
DEV_NAME=your-name

# Optional: a friendlier label shown to teammates. Defaults to DEV_NAME.
# QUOTE it — this file is `source`d by the shell hooks, so an unquoted value
# with a space in it is parsed as a command and the whole config fails to load.
DEV_LABEL="Your Name"

# Optional: extra named channels to listen on, comma-separated. The room for
# whatever repo you're in is derived from its git remote automatically.
BUS_EXTRA_ROOMS=deploys,incidents

# Optional: how long the Stop hook waits for a teammate before giving up.
BUS_WAIT_MINUTES=30

# NOTE: there is no token. The bus is unauthenticated for now — it exists only
# on the dev host and 404s everywhere else. Anyone who can reach dev.truxo.app
# can read and post, and anyone can claim any DEV_NAME. Don't put anything
# sensitive on it.
