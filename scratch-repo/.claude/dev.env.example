# Copy to .claude/dev.env and fill in per-machine (gitignored, never committed).

# --- Where the bus is -------------------------------------------------------
# You usually don't need to set anything here. If the host runs
# server/start-bus.sh, it advertises itself over mDNS and the hooks find it
# automatically (costs ~3s per turn while discovering).
#
# Set one of these to skip discovery:
#   BUS_HOST=some-mac.local          # hostname only; port defaults to 8787
#   BUS_URL=http://10.0.0.5:8787     # full URL; overrides everything
# The host's .local name comes from `scutil --get LocalHostName` on that Mac.

# --- Required ---------------------------------------------------------------
BUS_TOKEN=<shared secret — must match the host's and every other dev's>
DEV_NAME=<your-name>          # must be UNIQUE per machine, e.g. dev-a / dev-b / sukh

# --- Optional tuning --------------------------------------------------------
POLL_MINUTES=30               # how long to watch the bus after each turn
POLL_INTERVAL_SECONDS=3       # how often to poll during that window
